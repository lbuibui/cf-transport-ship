{
  "name": "cf-transport-ship",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "description": "CF-运输船 — 货轮场景 3D 战术竞技",
  "author": "evo",
  "homepage": "https://github.com/lbuibui/cf-transport-ship",
  "desktopName": "cf-transport-ship.desktop",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --dev",
    "smoke": "node smoke.mjs",
    "icon": "node tools/make-icon.mjs",
    "desktop": "node build.mjs && electron .",
    "desktop:dev": "node build.mjs --dev && electron . --dev",
    "smoke:desktop": "node build.mjs && node smoke-desktop.mjs",
    "check": "node tools/check-lockfile.mjs && node build.mjs && node smoke.mjs && node smoke-desktop.mjs",
    "check:lockfile": "node tools/check-lockfile.mjs",
    "dist:mac": "node build.mjs && electron-builder --mac",
    "dist:win": "node build.mjs && electron-builder --win",
    "dist:linux": "node build.mjs && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "three": "^0.186.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "electron-winstaller": true
  }
}
